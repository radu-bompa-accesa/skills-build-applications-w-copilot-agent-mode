# Environment variables for Vite

# Codespaces Configuration
# Set this to your Codespace name for deployments
# Example: VITE_CODESPACE_NAME=great-space-palindrome-1x9v5
# Leave empty to use localhost:8000 for local development
VITE_CODESPACE_NAME=

# API Base URL will be automatically constructed from VITE_CODESPACE_NAME
# In Codespaces: https://{VITE_CODESPACE_NAME}-8000.app.github.dev
# Locally: http://localhost:8000
